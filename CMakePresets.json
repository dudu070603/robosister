{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "DM_ID_CONFIG_MODE": "OFF",
                "ARM_MOTOR_JOG_TEST": "OFF"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ArmMotorJog",
            "inherits": "Debug",
            "cacheVariables": {
                "ARM_MOTOR_JOG_TEST": "ON"
            }
        },
        {
            "name": "DmIdConfig",
            "inherits": "Debug",
            "cacheVariables": {
                "DM_ID_CONFIG_MODE": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ArmMotorJog",
            "configurePreset": "ArmMotorJog"
        },
        {
            "name": "DmIdConfig",
            "configurePreset": "DmIdConfig"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
